# Local Docker Compose development defaults. Replace before using outside local development.
POSTGRES_USER=fileflow
POSTGRES_PASSWORD=fileflow_local_password
POSTGRES_DB=fileflow_db
DATABASE_URL=postgresql://fileflow:fileflow_local_password@localhost:5432/fileflow_db
DATABASE_MIGRATION_URL=postgresql://fileflow:fileflow_local_password@localhost:5432/fileflow_db
BETTER_AUTH_SECRET=fileflow_local_development_secret_32_chars
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
