# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Frontend dependencies, builds and reports
frontend/node_modules/
frontend/.next/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
