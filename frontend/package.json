{
  "name": "fileflow-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "auth:schema": "auth generate --config ./src/lib/auth/schema-generation.ts --output ./src/db/schema/auth.ts --yes && node ./scripts/ensure-auth-schema-indexes.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "audit:auth:schema": "node ./scripts/audit-auth-schema.mjs",
    "audit:bundle": "node ./scripts/audit-static-bundle.mjs",
    "lint": "eslint src e2e scripts next.config.ts drizzle.config.ts postcss.config.mjs eslint.config.mjs vitest.config.ts vitest.db.config.ts vitest.primary-db.config.ts playwright.config.ts playwright.auth-primary.config.ts playwright.smoke.config.ts playwright.visual.config.ts playwright.shared.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:auth:primary": "cross-env ALLOW_PRIMARY_AUTH_TESTS=true vitest run --config vitest.primary-db.config.ts",
    "test:auth:primary:e2e": "cross-env ALLOW_PRIMARY_AUTH_TESTS=true playwright test --config=playwright.auth-primary.config.ts",
    "test:auth:primary:all": "npm run test:auth:primary && npm run test:auth:primary:e2e",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:e2e:visual": "cross-env NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000 npm run build && playwright test --config=playwright.visual.config.ts"
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.27.0",
    "next": "16.2.10",
    "pg": "8.22.0",
    "radix-ui": "1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@next/env": "16.2.10",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "auth": "1.6.25",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
